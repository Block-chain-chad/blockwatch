# Copy this file to .env.local (git-ignored) and fill in what you have.

# Stock prices — Finnhub (recommended, free): register at https://finnhub.io/register,
# copy the API key from your dashboard. Without a key, local dev falls back to a
# keyless Yahoo Finance quote relay through the Vite dev server (dev only).
VITE_FINNHUB_API_KEY=

# Waitlist backend — Supabase (free): create a project at https://supabase.com,
# run supabase/waitlist.sql in the SQL editor, then copy from
# Project Settings → API: the Project URL and the anon public key.
# Without these, waitlist joins are saved locally and sync when configured.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Analytics — PostHog (free tier): create a project at https://posthog.com,
# copy the project API key (starts with phc_). Host only needs changing for
# EU-region projects (https://eu.i.posthog.com). Without a key, events just
# log to the dev console.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Trading switches. These are FALLBACKS ONLY — they decide what a session
# does while PostHog has not answered (no project key, request failed, still
# in flight). PostHog's answer always wins, which is what lets Terra switch
# trading off without a redeploy. See src/services/featureFlags.js.
#
# PostHog → Feature flags, flag key: in-app-swap
#   The in-app swap (build a Jupiter transaction, sign it in Phantom). Ships
#   OFF pending legal review of which regions may use it.
#   LEAVE THIS BLANK. Blank means an unreachable PostHog turns the swap off,
#   which is the whole point of the switch. Setting it to true makes ON the
#   fallback, so a session that cannot reach PostHog keeps swapping after the
#   flag has been turned off.
VITE_SWAP_ENABLED=

# PostHog → Feature flags, flag key: jupiter-link-out
#   The external "Trade on Jupiter" links and the Trade screen's Jupiter card.
#   Ships ON: it is a hyperlink to a public site, not a transaction OnStock
#   builds, and dropping it on every failed request would gut the Trade
#   screen. Set to false, or turn the PostHog flag off, to stop OnStock
#   pointing anyone at a venue.
VITE_JUPITER_LINK_OUT_ENABLED=

# PostHog → Feature flags, flag key: issuer-ratio-line
#   The one-line issuer ratio on the asset screen ("Issuer ratio: 1 token
#   tracks the value of 10 NFLX shares."). NOT trading functionality — it is a
#   sentence every visitor sees — but it describes what a tokenized security
#   represents, and it ships OFF until a lawyer has read it. It has its own
#   switch rather than riding the swap flag, so turning the swap on does not
#   publish the sentence with it.
#   LEAVE THIS BLANK. Blank means an unreachable PostHog keeps the line hidden.
VITE_ISSUER_RATIO_LINE_ENABLED=

# Sign-in switches, same rules as above: FALLBACKS ONLY, PostHog's answer
# wins. Each method works only once its provider is configured in the
# Supabase, Apple or Google dashboard, so each ships OFF.
#   PostHog flag keys: sign-in-apple, sign-in-google, sign-in-passkey
# LEAVE THESE BLANK and switch the methods on in PostHog.
VITE_SIGN_IN_APPLE_ENABLED=
VITE_SIGN_IN_GOOGLE_ENABLED=
VITE_SIGN_IN_PASSKEY_ENABLED=

# The Delete account row in Profile, same rules: FALLBACK ONLY, PostHog's
# answer wins. PostHog flag key: account-deletion. It ships OFF because
# api/delete-account.js answers 503 until SUPABASE_SECRET_KEY is set in Vercel
# (see SERVER ONLY below). Set that first, then switch the flag on in PostHog,
# and have it on before an iOS build goes to App Review.
# LEAVE THIS BLANK.
VITE_ACCOUNT_DELETION_ENABLED=

# Google sign-in in the iOS app: the iOS OAuth client ID from Google Cloud
# (Credentials, type iOS, bundle ID app.blockwatch). Public, not a secret; it
# belongs in .env.ios. Unset keeps the Google button hidden in the app.
VITE_GOOGLE_IOS_CLIENT_ID=

# SERVER ONLY. Never prefix these with VITE_ and never put them in a .env file
# that a build reads: set them in Vercel → Settings → Environment Variables.
#   SUPABASE_SECRET_KEY          Supabase secret key; api/delete-account.js uses
#                                it to delete the caller's account.
#   SUPABASE_URL                 optional; falls back to VITE_SUPABASE_URL.
#   APPLE_TEAM_ID                for revoking Sign in with Apple on deletion.
#   APPLE_SIGN_IN_KEY_ID         the Sign in with Apple key's ID.
#   APPLE_SIGN_IN_PRIVATE_KEY    that key's .p8 contents.

# Optional: CoinGecko Demo API key (free at https://www.coingecko.com/en/api/pricing).
# Raises rate limits over the public keyless tier — not required.
# Note: client-side keys are temporary — the edge proxy (later step) moves keys server-side.
VITE_COINGECKO_API_KEY=

# Crash reporting — Sentry (free tier): create a project at https://sentry.io,
# copy the DSN from Project Settings → Client Keys. Errors only, no tracing or
# replay. Without a DSN, crash reporting is simply off.
VITE_SENTRY_DSN=

# Telemetry in development. Off by default: `vite dev` sends nothing to Sentry
# or PostHog, so the issue list and the product numbers are real users only.
# Set to true only while testing the telemetry wiring itself.
VITE_TELEMETRY_IN_DEV=

# Which deployment this build is. Set automatically on Vercel from its own
# VERCEL_ENV (see vite.config.js), so leave it blank locally. Sentry and
# PostHog label every event with it — see src/lib/environment.js.
VITE_VERCEL_ENV=
