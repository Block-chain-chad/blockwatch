# Loaded by `vite build --mode ios` (on top of .env.local, which stays
# gitignored). The native app is not served from Vercel, so relative /api/*
# calls would go nowhere — point them at the production deployment instead.
# See src/services/apiBase.js. No secrets in this file.
VITE_API_BASE=https://blockwatch.app
# Leaves the web-only features (Holdings) out of the iPhone build. See
# src/webOnly.js and scripts/check-ios-bundle.mjs.
VITE_BUILD_TARGET=ios
