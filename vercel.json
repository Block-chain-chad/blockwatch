{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://onstock.app https://www.onstock.app https://blockwatch.app https://www.blockwatch.app https://api.coingecko.com https://lite-api.jup.ag https://*.supabase.co https://us.i.posthog.com https://eu.i.posthog.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp-report"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/confirm",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/|\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "blockwatch.app"
        }
      ],
      "destination": "https://onstock.app/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/|\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.blockwatch.app"
        }
      ],
      "destination": "https://onstock.app/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.onstock.app"
        }
      ],
      "destination": "https://onstock.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.onstock.app"
        }
      ],
      "destination": "https://onstock.app/:path*",
      "permanent": true
    }
  ]
}
